{
  "schemaVersion": 1,
  "externalPackages": [
    {
      "name": "@eduwork/dsh-oidc",
      "lock": "third_party/npm-015-rc1/dsh-oidc/LOCK.json",
      "requiredFiles": [
        "lib/client.js"
      ],
      "capabilities": [
        "oidc-pkce",
        "enterprise-key-binding",
        "enterprise-model-provider"
      ]
    },
    {
      "name": "@eduwork/dsh-mail",
      "lock": "third_party/npm-015-rc1/dsh-mail-assistant/LOCK.json",
      "requiredFiles": [
        "lib/index.js",
        "lib/client.js"
      ],
      "capabilities": [
        "imap-readonly",
        "smtp-approval-gated"
      ]
    },
    {
      "name": "@shlv/dsh-literature",
      "lock": "third_party/dsh-literature/LOCK.json",
      "requiredFiles": [
        "cordis.patch.yml"
      ],
      "capabilities": [
        "literature-search",
        "literature-bibtex",
        "literature-fulltext",
        "notebook-source-provider"
      ]
    },
    {
      "name": "@eduwork/dsh-artifact-services",
      "lock": "third_party/npm-015-rc1/dsh-artifact-services/LOCK.json",
      "requiredFiles": [
        "lib/dsh.js",
        "lib/office.js",
        "lib/runtime.js",
        "python/runner.py",
        "media/bgm/catalog.json"
      ],
      "capabilities": [
        "shared-office",
        "speech-provider-registry",
        "shared-remotion",
        "editable-video-project"
      ]
    },
    {
      "name": "@eduwork/dsh-knowledge-studio",
      "lock": "third_party/npm-015-rc1/dsh-knowledge-studio/LOCK.json",
      "requiredFiles": [
        "lib/index.js",
        "lib/client.js",
        "cordis.patch.yml"
      ],
      "capabilities": [
        "workspace-studio",
        "local-source-retrieval",
        "studio-artifacts"
      ]
    },
    {
      "name": "@eduwork/dsh-memory",
      "lock": "third_party/npm-015-rc1/dsh-memory-native/LOCK.json",
      "requiredFiles": [
        "lib/index.js",
        "lib/client.js",
        "lib/spec.js",
        "lib/typert.host.js",
        "cordis.patch.yml"
      ],
      "capabilities": [
        "local-memory",
        "prior-chat-retrieval",
        "memory-management"
      ]
    }
  ],
  "localPlugins": [
    {
      "source": "dsh-plugins/artifact-preview-native",

    },
    {
      "name": "knowledge-studio",
      "sourcePackage": "@eduwork/dsh-knowledge-studio",
      "sourcePath": "skills/knowledge-studio",
      "requiresPackageCapability": "configurableSkills",
      "defaultEnabled": true
    },
    {
      "name": "artifact-images",
      "sourcePackage": "@eduwork/dsh-artifact-services",
      "sourcePath": "skills/images",
      "defaultEnabled": true
    }

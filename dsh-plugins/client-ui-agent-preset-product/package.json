{
  "name": "@chatecnu-work/dsh-client-ui-agent-preset-product",
  "version": "0.1.0-dev",
  "description": "DSH Agent Presets derivative adding product optional-preset enable switches",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib/**/*.js", "README.md", "NOTICE", "UPSTREAM.md"],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "chatecnuWork": {
    "schemaVersion": 1,
    "kind": "compat-plugin",
    "replaces": ["@deepseek-ai/dsh-client-ui-agent-preset"],
    "contractVersion": "dsh-client-ui-agent-preset@0.1.2-rc.1",
    "upstreamCommit": "a66e4702047846cdaa10c66c9d3df3951f5ea70d",
    "diffScope": [
      "package identity rebind",
      "show shipped optional presets while disabled",
      "toggle optional preset discovery through product settings",
      "refresh the official roster-backed settings and hero surfaces after toggles"
    ],
    "sunsetWhen": "DSH supports catalogued-but-disabled presets and enable controls in the official Agent Presets page"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.2-rc.1",
    "react": "^18.2.0"
  },
  "license": "MIT"
}

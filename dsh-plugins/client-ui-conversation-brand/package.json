  "license": "MIT",
  "chatecnuWork": {
    "schemaVersion": 1,
    "kind": "compat-plugin",
    "replaces": ["@deepseek-ai/dsh-client-ui-conversation"],
    "contractVersion": "dsh-client-ui-conversation@0.1.2-rc.1",
    "upstreamCommit": "a66e4702047846cdaa10c66c9d3df3951f5ea70d",
    "diffScope": ["package identity rebind", "empty-conversation hero copy", "release-channel badge", "unified add-control child slot"],

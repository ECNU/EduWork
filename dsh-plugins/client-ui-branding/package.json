{
  "name": "@chatecnu-work/dsh-client-ui-branding",
  "version": "0.1.0-dev",
  "license": "MIT",
  "description": "Configurable EduWork identity, brand slots and visual-style preferences for DSH",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./theme": "./lib/theme.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "README.md"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "chatecnuWork": {
    "schemaVersion": 1,
    "kind": "ui-extension",
    "uses": [
      "theme.overrideTokens",
      "sidebar.brand.mark",
      "sidebar.brand.name",
      "conversation.hero.brand.mark",
      "settings.general.item",
      "settingsScope"
    ],
    "replaces": [],
    "removable": true
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.2-rc.1",
    "react": "^18.2.0"
  }
}

{
  "name": "@eduwork/dsh-mail",
  "version": "0.1.1",
  "description": "Standards-based IMAP/SMTP mail assistant for DeepSeek Harness with explicit read/send controls and approval-aware delivery",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "email",
    "imap",
    "smtp",
    "mail-assistant"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/**/*.js",
    "docs/**/*.md",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "CODE_OF_CONDUCT.md",
    "CODE_OF_CONDUCT.en.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.en.md",
    "GOVERNANCE.md",
    "GOVERNANCE.en.md",
    "LICENSE",
    "MAINTAINERS.md",
    "MAINTAINERS.en.md",
    "SECURITY.md",
    "SECURITY.en.md",
    "SUPPORT.md",
    "SUPPORT.en.md",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_NOTICES.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:host": "tsdown --config tsdown.host.config.ts",
    "build:client": "tsdown",
    "build": "npm run clean && npm run build:host && npm run build:client",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "accept:dsh-rc1": "node scripts/accept-dsh-rc1.mjs 0.1.2-rc.1",
    "accept:dsh-013": "node scripts/accept-dsh-rc1.mjs 0.1.3-alpha.1",
    "accept:dsh-013-alpha2": "node scripts/accept-dsh-rc1.mjs 0.1.3-alpha.2",
    "accept:dsh-015": "node scripts/accept-dsh-rc1.mjs 0.1.5-alpha.1",
    "accept:dsh-015-rc1": "node scripts/accept-dsh-rc1.mjs 0.1.5-rc.1",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:bundle": "node scripts/check-host-bundle.mjs",
    "check:dsh": "node scripts/check-dsh-compat.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run check:bundle && npm run check:dsh && npm run check:docs && npm run check:secrets && npm run check:licenses && npm pack --dry-run",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecnu/EduWork.git",
    "directory": "packages/dsh-mail"
  },
  "bugs": {
    "url": "https://github.com/ecnu/EduWork/issues"
  },
  "homepage": "https://github.com/ecnu/EduWork/tree/main/packages/dsh-mail#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-rc.1 || 0.1.3-alpha.1 || 0.1.3-alpha.2 || 0.1.5-alpha.1 || 0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1 || 0.1.3-alpha.1 || 0.1.3-alpha.2 || 0.1.5-alpha.1 || 0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1 || 0.1.3-alpha.1 || 0.1.3-alpha.2 || 0.1.5-alpha.1 || 0.1.5-rc.1",
    "@deepseek-ai/dsh-credentials": "0.1.2-rc.1 || 0.1.3-alpha.1 || 0.1.3-alpha.2 || 0.1.5-alpha.1 || 0.1.5-rc.1",
    "@deepseek-ai/dsh-permission-presets": "0.1.2-rc.1 || 0.1.3-alpha.1 || 0.1.3-alpha.2 || 0.1.5-alpha.1 || 0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1 || 0.1.3-alpha.1 || 0.1.3-alpha.2 || 0.1.5-alpha.1 || 0.1.5-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-permission-presets": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.28",
    "imapflow": "^1.7.0",
    "mailparser": "^3.9.23",
    "nodemailer": "^9.1.0",
    "react": "^18.3.1",
    "tsdown": "0.22.14",
    "typescript": "^5.9.3"
  },
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "test"
  },
  "author": ""
}

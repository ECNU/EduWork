{
  "name": "@eduwork/dsh-oidc",
  "version": "0.3.0",
  "description": "Standards-based OIDC identity, token-authorized model access, declarative branding, and OpenAI-compatible model integration for DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "oidc",
    "openid-connect",
    "enterprise",
    "sso"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./profile": "./lib/profile.js",
    "./oidc": "./lib/oidc.js",
    "./provider": "./lib/provider/index.js",
    "./transforms": "./lib/provider/transforms.js",
    "./typert": "./lib/typert.host.js",
    "./remote": "./lib/typert.remote-client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/**/*.js",
    "docs/**/*.md",
    "examples/**/*.json",
    "schema/**/*.json",
    "protocol/openapi.yaml",
    "protocol/resources.openapi.yaml",
    "README.md",
    "README_EN.md",
    "CODE_OF_CONDUCT.md",
    "CODE_OF_CONDUCT.en.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.en.md",
    "GOVERNANCE.md",
    "GOVERNANCE.en.md",
    "MAINTAINERS.md",
    "MAINTAINERS.en.md",
    "SECURITY.md",
    "SECURITY.en.md",
    "SUPPORT.md",
    "SUPPORT.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_NOTICES.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build:host": "node scripts/build-host.mjs",
    "build:client": "tsdown",
    "build": "npm run build:host && npm run build:client",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/*.test.js\"",
    "check:schemas": "node scripts/check-schemas.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:dsh": "npm run check:lock && node scripts/check-dsh-rc1.mjs",
    "check:build": "node scripts/smoke-build.mjs",
    "check": "npm run typecheck && npm run check:dsh && npm run build && npm run check:build && npm test && npm run check:schemas && npm run check:docs && npm run check:secrets && npm run check:licenses && npm pack --dry-run",
    "prepare": "npm run build",
    "check:browser": "node scripts/check-account-menu-browser.mjs",
    "check:lock": "node scripts/check-dependency-lock.mjs"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ECNU/EduWork.git",
    "directory": "packages/dsh-oidc"
  },
  "bugs": {
    "url": "https://github.com/ECNU/EduWork/issues"
  },
  "homepage": "https://github.com/ECNU/EduWork/tree/main/packages/dsh-oidc#readme",
  "license": "MIT",
  "dependencies": {

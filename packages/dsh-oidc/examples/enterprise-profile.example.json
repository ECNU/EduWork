{
  "schemaVersion": "dsh-oidc/v1alpha1",
  "id": "example-university",
  "displayName": "Example University AI",
  "organization": "Example University",
  "brand": {
    "productName": "Example AI Work",
    "organizationName": "Example University",
    "mark": "E",
    "primaryColor": "#5157af",
    "loginTitle": "Sign in with Example University",
    "loginDescription": "Authenticate with the university identity provider and bind a model runtime credential. Your password never enters DSH.",
    "supportURL": "https://support.example.edu/ai"
  },
  "oidc": {
    "issuer": "https://id.example.edu/oidc",
    "clientId": "replace-with-public-client-id",
    "scopes": [
      "openid",
      "profile",
      "offline_access",
      "worker.bootstrap.read",
      "worker.credential.provision",
      "worker.credential.read",
      "worker.credential.renew"
    ]
  },
  "keyBinding": {
    "baseURL": "https://ai.example.edu/api/worker/v1",
    "credentialRef": "EDUWORK_API_KEY"
  },
  "provider": {
    "id": "example-ai",
    "displayName": "Example AI",
    "adapter": "openai-compatible",
    "baseURL": "https://ai.example.edu/open/api/v1",
    "reasoning": "high",
    "defaultContextWindow": 262144,
    "defaultMaxTokens": 32768,
    "streamIdleTimeoutMs": 300000,
    "retryPolicy": {
      "mode": "normal",
      "maxRetries": 2
    },
    "compat": {
      "supportsDeveloperRole": false,
      "supportsStore": false,
      "supportsReasoningEffort": true,
      "supportsUsageInStreaming": true,
      "maxTokensField": "max_tokens",
      "supportsStrictMode": false,
      "supportsLongCacheRetention": false,
      "thinkingFormat": "deepseek",
      "requiresReasoningContentOnAssistantMessages": true
    },
    "models": [
      {
        "id": "example-max",
        "name": "Example Max",
        "input": ["text"],
        "reasoningEfforts": {
          "max": "max",
          "high": "high",
          "low": "low"
        },
        "defaultReasoningEffort": "high"
      },
      {
        "id": "example-plus",
        "name": "Example Plus",
        "input": ["text", "image"],
        "compat": {
          "supportsReasoningEffort": false
        }
      }
    ]
  }
}

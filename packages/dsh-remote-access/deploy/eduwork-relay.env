# Configuration for eduwork-relay.service. Installed at /etc/eduwork-relay.env.
#
# The relay forwards bytes it cannot read; it holds no key material, so there is
# no secret in this file.

# Loopback only. Caddy terminates TLS and proxies here.
EDUWORK_RELAY_BIND=127.0.0.1
EDUWORK_RELAY_PORT=8792

# The host registry is trust-on-first-use: the first key to claim a host id keeps
# it, and losing this file means losing that binding. It lives under the unit's
# StateDirectory so it survives a redeploy of /opt/eduwork-relay.
EDUWORK_RELAY_STORE=/var/lib/eduwork-relay/hosts.json

# Browser assets the relay injects into the page it serves.
EDUWORK_RELAY_WEB_ROOT=/opt/eduwork-relay/web
EDUWORK_RELAY_FRONTEND_ROOT=/opt/eduwork-relay/frontend

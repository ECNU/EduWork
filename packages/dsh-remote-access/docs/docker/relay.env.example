# Public HTTPS URL, including any prefix. Use the same URL on the desktop.
RELAY_URL=https://remote.example.edu/eduwork-remote/

# Replace with a random key; multiple keys are comma-separated.
# For OIDC-only deployments, leave this empty and configure BOTH OIDC values.
RELAY_ACCESS_KEYS=

# Optional organization sign-in; use your issuer and desktop application's ID.
# RELAY_OIDC_ISSUER=https://sso.example.edu
# RELAY_OIDC_CLIENT_IDS=desktop-client-id

# Optional: the trusted reverse proxy must OVERWRITE this request header.
# RELAY_CLIENT_IP_HEADER=x-real-ip

# Optional iframe parents: self, or complete origins separated by spaces.
# RELAY_FRAME_ANCESTORS=self https://portal.example.edu

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verymath.org/schemas/math-glossary/glossary.schema.json",
  "title": "VeryMath bilingual mathematical glossary",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "term_id",
      "en",
      "cn",
      "created_at",
      "updated_at"
    ],
    "properties": {
      "term_id": {
        "type": "string",
        "minLength": 1
      },
      "en": {
        "type": "string",
        "minLength": 1
      },
      "cn": {
        "type": "string",
        "minLength": 1
      },
      "idx": {
        "type": "integer",
        "minimum": 1
      },
      "pos": {
        "type": "string"
      },
      "field": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "source": {
        "type": "string"
      },
      "examples": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "en",
            "cn"
          ],
          "properties": {
            "en": {
              "type": "string"
            },
            "cn": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "created_at": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "updated_at": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    },
    "additionalProperties": false
  }
}

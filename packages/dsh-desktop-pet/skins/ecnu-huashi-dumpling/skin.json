  "states": {
    "idle": [
      "idle",
      "smile",
      "greet",
      "hug",
      "desk-peek",
      "yawn"
    ],
    "working": [
      "think",
      "work"
    ]
  },
  "lines": {
    "done": {
      "zh-CN": [
        "做好啦，来看看！"
      ],
      "en": [
        "All done! Come take a look."
      ]
    },
    "attention": {
      "zh-CN": [
        "等你来帮个忙。"
      ],
      "en": [
        "Could you help me here?"
      ]
    },
    "failed": {
      "zh-CN": [
        "唔，遇到点麻烦。"
      ],
      "en": [
        "Hmm, something went wrong."
      ]
    }
  }

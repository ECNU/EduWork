{
  "name": "@eduwork/dsh-desktop-pet",
  "version": "0.1.0",
  "description": "Desktop pet for DSH applications with the EduWork Electron desktop bridge",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./remote": "./lib/typert.remote-client.js",
    "./skin": "./lib/skin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skins",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build:skins": "node scripts/build-page-skins.mjs && node scripts/build-huashi-skin.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm run build && npm test"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": ">=3.18.0 <3.19.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.2 <0.3.0-0",
    "react": "^18.2.0",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "esbuild": "0.28.1",
    "react": "18.3.1",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ECNU/EduWork.git",
    "directory": "packages/dsh-desktop-pet"
  },
  "homepage": "https://github.com/ECNU/EduWork/tree/main/packages/dsh-desktop-pet#readme",
  "bugs": {
    "url": "https://github.com/ECNU/EduWork/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "desktop-pet",
    "eduwork"
  ],
  "publishConfig": {
    "access": "public"
  }
}
